# Environment variables for MindWellAI

# Primary AI provider for chatbot responses:
# Create a Groq API key and paste it here.
GROQ_API_KEY=your_groq_api_key_here

# Optional override for the Groq model name.
AI_MODEL=llama-3.3-70b-versatile

# Voice replies via ElevenLabs.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: choose a different voice and model.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Required for auth tokens in production. Replace this before deploying.
JWT_SECRET=change_this_to_a_long_random_secret

# Optional database URL.
# Leave commented out for local development to use in-memory storage for free.
# DATABASE_URL=postgresql://username:password@host/database

# Optional fallback for another OpenAI-compatible provider.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
